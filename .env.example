# Copy to .env and adjust.

# Login for the web UI, API and the KOReader OPDS catalog.
APP_USER=admin
APP_PASSWORD=change-me
APP_NAME=Bookhoard

# Files written to ./books will be owned by this user/group on the host
PUID=1000
PGID=1000

# How often (seconds) the ingest folder is checked
SCAN_INTERVAL=30

# --- lubimyczytac.pl metadata ---
# match new books automatically
LC_AUTO_METADATA=true
# 0..1 – how sure a match must be to auto-apply
LC_MIN_SCORE=0.72
# seconds between requests (be polite)
LC_REQUEST_DELAY=1.0
# which lubimyczytac labels become tags: categories (genres only) or all
LC_TAG_SOURCE=categories
# embed edited title/author/series/tags into EPUB files
WRITE_EPUB_METADATA=false

# --- Anna's Archive ---
# Comma-separated mirrors, tried in order (domains change from time to time)
AA_BASE_URLS=https://annas-archive.gl
# Membership "secret key" from your Anna's Archive account page → fast, reliable downloads
AA_API_KEY=
AA_DEFAULT_LANG=pl
AA_DEFAULT_EXT=epub
LIBGEN_BASE_URLS=https://libgen.li
# Where Discover searches: auto (Anna's Archive, then LibGen), libgen, annas
SEARCH_SOURCE=auto
# Optional outbound proxy for all scraping/downloads, e.g. a VPN container
OUTBOUND_PROXY=

LOG_LEVEL=INFO
